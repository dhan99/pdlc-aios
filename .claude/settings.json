{
  "permissions": {
    "deny": [
      "Read(.env)", "Read(.env.*)", "Read(**/*.pem)",
      "Read(~/.ssh/**)", "Read(~/.secrets/**)"
    ]
  },
  "env": { "LANGSMITH_PROJECT": "pdlc-aios" },
  "hooks": {       
    "PreToolUse": [         
    	{ "matcher": "Bash",  
        "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/deny-danger.sh" }] },
    	{ "matcher": "Edit|Write",  
        "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/protect-paths.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/lint-test-touched.sh" }] }
    ]
  }
}
